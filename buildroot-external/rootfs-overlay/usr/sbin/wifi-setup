#!/bin/sh
#
# wifi-setup - first-time setup for Home Assistant OS without typing long
# commands: WiFi networks and, optionally, a root password for SSH.
#
# Interactive:   wifi-setup
#     Asks for a primary and an optional backup network plus an optional SSH
#     password, installs the NetworkManager profiles and saves the network
#     settings to /mnt/boot/wifi.conf - the FAT boot partition of the SD card,
#     which mounts on any PC.
#
# Change SSH:    wifi-setup --ssh-password
# At boot:       wifi-setup --apply
# Show:          wifi-setup --show
#
# wifi.conf may also carry ssh_password=... so a card can be prepared entirely
# from a PC. It is applied once and then removed from the file.
#
# The WiFi profiles live in /etc/NetworkManager/system-connections and the root
# password in /etc/shadow; both are bind mounts from the overlay partition, so
# they survive reboots and OS updates. The PSK is stored in clear text there,
# exactly as NetworkManager always does.

set -eu

BOOT_CONF="/mnt/boot/wifi.conf"
NM_DIR="/etc/NetworkManager/system-connections"
STAMP="/var/lib/wifi-setup.stamp"
PW_MARKER="/root/.ssh/.password-auth"

die() {
    echo "[Error] $*" >&2
    exit 1
}

wifi_device() {
    dev=$(nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2 == "wifi" { print $1; exit }')
    [ -n "${dev}" ] || dev="wlan0"
    echo "${dev}"
}

# Strip a trailing CR so a wifi.conf edited on Windows still parses. Without
# this the CR ends up inside the PSK and the access point rejects the key.
strip_cr() {
    printf '%s' "$1" | tr -d '\r'
}

valid_psk() {
    len=$(printf '%s' "$1" | wc -c)
    [ "${len}" -ge 8 ] && [ "${len}" -le 63 ]
}

##
# Root password

set_ssh_password() {
    _pw=$1
    [ -n "${_pw}" ] || die "refusing to set an empty root password"

    # Feed it on stdin rather than as an argument - arguments are visible in ps.
    _hash=$(printf '%s\n' "${_pw}" | cryptpw -m sha512) || die "could not hash the password"
    case "${_hash}" in
        \$6\$*) : ;;
        *)      die "unexpected hash format from cryptpw" ;;
    esac
    # A colon or whitespace would split the shadow record and lock the account
    # out, so refuse rather than write a broken /etc/shadow.
    case "${_hash}" in
        *:*|*[[:space:]]*) die "refusing to write a malformed hash" ;;
    esac

    [ -f /etc/shadow ] || die "/etc/shadow is missing"
    _tmp="/tmp/shadow.$$"
    awk -v h="${_hash}" 'BEGIN { FS = OFS = ":" } $1 == "root" { $2 = h; found = 1 } { print } END { exit(found ? 0 : 1) }' /etc/shadow > "${_tmp}" || { rm -f "${_tmp}"; die "no root entry in /etc/shadow"; }

    # Write in place. /etc is read-only, so creating a new file and renaming it
    # over /etc/shadow would fail; the bind mount makes the file itself
    # writable even though its directory is not.
    cat "${_tmp}" > /etc/shadow
    rm -f "${_tmp}"
    chmod 600 /etc/shadow 2>/dev/null || true

    mkdir -p /root/.ssh
    echo "enabled" > "${PW_MARKER}"
    chmod 600 "${PW_MARKER}"

    systemctl restart dropbear >/dev/null 2>&1 || true
    echo "[Info] Root password set; SSH password login enabled on port 22222"
}

##
# Profiles

write_profile() {
    _ssid=$1
    _psk=$2
    _prio=$3
    _dev=$(wifi_device)
    _file="${NM_DIR}/${_ssid}.nmconnection"
    _uuid=$(cat /proc/sys/kernel/random/uuid)

    ( umask 077 && cat > "${_file}" <<PROFILE
[connection]
id=${_ssid}
uuid=${_uuid}
type=wifi
interface-name=${_dev}
autoconnect=true
autoconnect-priority=${_prio}
autoconnect-retries=0

[wifi]
mode=infrastructure
ssid=${_ssid}

[wifi-security]
auth-alg=open
key-mgmt=wpa-psk
psk=${_psk}

[ipv4]
method=auto

[ipv6]
addr-gen-mode=default
method=auto
PROFILE
    )
    chmod 600 "${_file}"
    echo "[Info] Wrote profile for '${_ssid}' (priority ${_prio})"
}

read_conf() {
    SSID=""; PSK=""; SSID_BACKUP=""; PSK_BACKUP=""; SSH_PASSWORD=""
    [ -f "${BOOT_CONF}" ] || return 1
    while IFS='=' read -r key value; do
        key=$(strip_cr "${key}")
        value=$(strip_cr "${value}")
        case "${key}" in
            ''|\#*)       continue ;;
            ssid)         SSID=${value} ;;
            psk)          PSK=${value} ;;
            ssid_backup)  SSID_BACKUP=${value} ;;
            psk_backup)   PSK_BACKUP=${value} ;;
            ssh_password) SSH_PASSWORD=${value} ;;
        esac
    done < "${BOOT_CONF}"
    [ -n "${SSID}" ]
}

# Never writes ssh_password back out, so applying one removes it from the card.
write_conf() {
    ( umask 077 && cat > "${BOOT_CONF}" <<CONF
# Home Assistant OS WiFi configuration.
#
# Edit this file from any PC with the SD card inserted, then reboot the board.
# Leave the backup network empty if there is only one.
#
# Adding a line "ssh_password=secret" sets the root password on the next boot
# and enables SSH password login on port 22222. The line is removed from this
# file once it has been applied.
ssid=${SSID}
psk=${PSK}
ssid_backup=${SSID_BACKUP}
psk_backup=${PSK_BACKUP}
CONF
    )
    echo "[Info] Saved ${BOOT_CONF}"
}

install_profiles() {
    [ -d "${NM_DIR}" ] || die "${NM_DIR} is missing - is NetworkManager installed?"

    # Only remove profiles this script owns, so a connection added by hand or
    # by the Supervisor is left alone.
    for f in "${NM_DIR}"/*.nmconnection; do
        [ -e "${f}" ] || continue
        grep -q '^autoconnect-retries=0$' "${f}" 2>/dev/null && rm -f "${f}"
    done

    write_profile "${SSID}" "${PSK}" 100
    if [ -n "${SSID_BACKUP}" ] && [ -n "${PSK_BACKUP}" ]; then
        write_profile "${SSID_BACKUP}" "${PSK_BACKUP}" 50
    fi

    nmcli con reload >/dev/null 2>&1 || true
    nmcli con up "${SSID}" >/dev/null 2>&1 || true
}

stamp() {
    mkdir -p "$(dirname "${STAMP}")"
    md5sum "${BOOT_CONF}" > "${STAMP}" 2>/dev/null || true
}

##
# Prompts

ask() {
    printf '%s' "$1"
    IFS= read -r REPLY
    REPLY=$(strip_cr "${REPLY}")
}

ask_secret() {
    printf '%s' "$1"
    if [ -t 0 ]; then
        stty -echo 2>/dev/null || true
        IFS= read -r REPLY
        stty echo 2>/dev/null || true
        echo
    else
        IFS= read -r REPLY
    fi
    REPLY=$(strip_cr "${REPLY}")
}

prompt_ssh_password() {
    while :; do
        ask_secret "New SSH password for root (empty to skip): "
        _first=${REPLY}
        [ -n "${_first}" ] || { echo "Skipped."; return 1; }
        if [ "$(printf '%s' "${_first}" | wc -c)" -lt 8 ]; then
            echo "Please use at least 8 characters."
            continue
        fi
        ask_secret "Repeat it: "
        [ "${REPLY}" = "${_first}" ] && break
        echo "The two entries differ, try again."
    done
    SSH_PASSWORD=${_first}
    return 0
}

interactive() {
    echo
    echo "Home Assistant OS - first-time setup"
    echo "===================================="
    echo

    while :; do
        ask "Primary network name (SSID): "
        SSID=${REPLY}
        [ -n "${SSID}" ] && break
        echo "The SSID cannot be empty."
    done

    while :; do
        ask_secret "Password for '${SSID}': "
        PSK=${REPLY}
        valid_psk "${PSK}" && break
        echo "The password must be between 8 and 63 characters."
    done

    echo
    ask "Backup network name (SSID), or press Enter to skip: "
    SSID_BACKUP=${REPLY}
    PSK_BACKUP=""
    if [ -n "${SSID_BACKUP}" ]; then
        while :; do
            ask_secret "Password for '${SSID_BACKUP}': "
            PSK_BACKUP=${REPLY}
            valid_psk "${PSK_BACKUP}" && break
            echo "The password must be between 8 and 63 characters."
        done
    fi

    echo
    echo "SSH gives you a shell on port 22222. Leave the password empty to keep"
    echo "SSH key-only (put your key in CONFIG/authorized_keys on the SD card)."
    SSH_PASSWORD=""
    prompt_ssh_password || true

    echo
    write_conf
    install_profiles
    stamp
    if [ -n "${SSH_PASSWORD}" ]; then
        set_ssh_password "${SSH_PASSWORD}"
    fi

    echo
    echo "Done. Check the connection with: nmcli device status"
}

case "${1:-}" in
    --apply)
        # Boot-time path: stay quiet and do nothing unless wifi.conf changed.
        read_conf || exit 0
        if [ -f "${STAMP}" ] && md5sum -c "${STAMP}" >/dev/null 2>&1; then
            exit 0
        fi
        install_profiles
        if [ -n "${SSH_PASSWORD}" ]; then
            set_ssh_password "${SSH_PASSWORD}"
            write_conf
        fi
        stamp
        ;;
    --ssh-password)
        SSH_PASSWORD=""
        prompt_ssh_password || exit 0
        set_ssh_password "${SSH_PASSWORD}"
        ;;
    --show)
        read_conf || die "No ${BOOT_CONF} yet - run wifi-setup first."
        echo "Primary: ${SSID}"
        if [ -n "${SSID_BACKUP}" ]; then
            echo "Backup:  ${SSID_BACKUP}"
        fi
        if [ -s "${PW_MARKER}" ]; then
            echo "SSH:     password login enabled on port 22222"
        else
            echo "SSH:     key only (no root password set)"
        fi
        ;;
    --help|-h)
        sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    '')
        interactive
        ;;
    *)
        die "Unknown option '$1' - try --help"
        ;;
esac
