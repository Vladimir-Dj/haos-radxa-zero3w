# CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y

CONFIG_THERMAL_GOV_BANG_BANG=y

CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_GPIO_POLLED=y

CONFIG_MMC_SDHCI_OF_DWCMSHC=y

# CONFIG_DW_WATCHDOG is not set

# AIC8800 SDIO WiFi power sequencing (mmc-pwrseq-simple)
CONFIG_PWRSEQ_SIMPLE=y

# AIC8800 Bluetooth: H4 over uart1. There is deliberately NO device tree node
# for it - aic8800-bt.service attaches the controller with btattach from
# userspace. A brcm,bcm43438-bt node was tried and reverted: mainline binds
# btbcm, which the chip never answers. See Documentation/radxa-zero3w-changes.md.
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_BCM=y
